# ==========================================
# 1. Google Gemini 模型與 API 金鑰設定
# ==========================================
# Google AI Studio API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 指定預設 Gemini 轉檔多模態模型 (預設 gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 指定預設 Gemini Embedding 文本向量模型 (預設 gemini-embedding-001，768維)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini 生成採樣溫度 (建議 0.0 ~ 0.2，降低幻覺並保證結構確定性，預設 0.2)
GEMINI_TEMPERATURE=0.2

# Gemini 單次最大輸出 Token 上限 (預設 8192)
GEMINI_MAX_OUTPUT_TOKENS=8192

# ==========================================
# 2. 轉檔與品質審查控制 (true / false)
# ==========================================
# 是否預設開啟兩階段自我審核與自動修復 (Self-Refinement，透過 Chat 對照原圖二次校驗)
GEMINI_REVIEW=true

# 多模態 Review 圖片最大頁數門檻 (超過此頁數時第 2 輪自我校驗自動走文字級結構優化，避免重複送入大量高解析圖片 Token，預設 5)
VISION_REVIEW_MAX_PAGES=5

# 是否預設開啟獨立評判員評分卡 (LLM-as-a-Judge，輸出 JSON 評分卡)
GEMINI_JUDGE=false

# 確定性品管閥放行門檻 (滿分 100，低於此分數將被自動隔離)
QUALITY_THRESHOLD=65

# 確定性品管閥篇幅保留率下限 (低於此比例判定過度偷懶或文字截斷，預設 0.35 即 35%)
QUALITY_MIN_RETENTION_RATIO=0.35

# 確定性品管閥篇幅保留率上限 (高於此比例判定有異常重複文字，預設 3.5 即 350%)
QUALITY_MAX_RETENTION_RATIO=3.5

# ==========================================
# 3. 資源配額與安全防護限制
# ==========================================
# 單一檔案大小上限 (MB，預設 25MB)
MAX_FILE_SIZE_MB=25

# 單一 PDF 最大處理頁數 (防範 DoS 阻斷服務攻擊，預設 30 頁)
MAX_PDF_PAGES=30

# DOCX 解壓縮膨脹比上限 (防範 Zip Bomb 阻斷服務攻擊，預設 10.0x)
MAX_DOCX_EXPANSION_RATIO=10.0

# DOCX 解壓縮後總體積上限 (MB，防範超大 Zip 佔滿記憶體，預設 100MB)
MAX_DOCX_UNCOMPRESSED_MB=100

# PDF 渲染轉 PNG 之解析度 DPI (預設 150，兼顧多模態視覺辨識率與 Token/記憶體能效)
PDF_RENDER_DPI=150

# RapidOCR 離線辨識時之影像渲染解析度 DPI (預設 200)
PDF_OCR_DPI=200

# 健康文字 PDF 走 Text-First 策略之最小字元數門檻 (預設 50 字)
PDF_TEXT_FIRST_MIN_CHARS=50

# 判斷為純掃描檔之文字門檻 (前兩頁字元數低於此值視為無文字層，預設 30)
PDF_SCANNED_MIN_CHARS=30

# 判斷為 104 混淆字型之亂碼字元數門檻 (預設 10)
PDF_OBFUSCATED_UFFFD_THRESHOLD=10

# 判斷為 104 混淆字型之刪除線標記門檻 (預設 30)
PDF_OBFUSCATED_STRIKETHROUGH_THRESHOLD=30

# ==========================================
# 4. 外部 API 網路重試與退避策略
# ==========================================
# 外部 API (Gemini 等) 遭遇 Transient Error 時最大重試次數 (預設 3 次)
API_MAX_RETRIES=3

# 外部 API 失敗重試之基礎延遲秒數 (Exponential Backoff 基礎乘數，預設 2.0 秒)
API_RETRY_DELAY=2.0

# ==========================================
# 5. Redis 向量資料庫與索引配置
# ==========================================
# Redis 節點連線位址 (支援 Docker RediSearch 或遠端 Redis Stack)
REDIS_URL=redis://localhost:6379/0

# QA 端到端測試專用 Redis 連線 (預設使用 DB 15 進行環境隔離，避免污染生產庫 DB 0)
REDIS_TEST_URL=redis://localhost:6379/15

# 向量索引名稱 (方便藍綠部署與多環境隔離)
REDIS_INDEX_NAME=idx:resumes:v1

# Redis 切片鍵前綴 (Key Prefix)
REDIS_PREFIX=resume:v1:chunk:

# Redis 內容 Hash 指紋快取前綴 (Key Prefix)
REDIS_HASH_PREFIX=resume:v1:hash:

# RediSearch HNSW 向量圖最大出度 (連接數 M，預設 16)
REDIS_HNSW_M=16

# RediSearch HNSW 索引建置搜尋深度 (EF_CONSTRUCTION，預設 200)
REDIS_HNSW_EF_CONSTRUCTION=200

# RediSearch HNSW 向量索引初始預留容量 (預設 1000)
REDIS_HNSW_INITIAL_CAP=1000

# 向量距離度量方式 (COSINE, IP, L2，預設 COSINE)
REDIS_DISTANCE_METRIC=COSINE

# ==========================================
# 6. 履歷切片、Embedding 與檢索微調
# ==========================================
# 切片最小字數門檻 (低於此值將觸發相鄰區塊語意合併，預設 80)
MIN_CHUNK_SIZE=80

# 切片最大字數門檻 (超過此值將強制切割，預設 1500)
MAX_CHUNK_SIZE=1500

# 文本向量 Embedding 維度 (gemini-embedding-001 預設 768)
EMBEDDING_DIM=768

# Embedding 批次處理大小 (每批次送出文本數，預設 20)
EMBEDDING_BATCH_SIZE=20

# 向量自然語言搜尋預設回傳數量 (Top-K，預設 5)
SEARCH_DEFAULT_TOP_K=5

# 向量檢索最低相似度門檻 (0.0 代表不截斷，可設 0.5 過濾低相關切片，預設 0.0)
SEARCH_MIN_SCORE=0.0

# 額外擴充之技能標籤 (以逗號分隔，如: swift,flutter,rust,solidity)
EXTRA_SKILL_PATTERNS=

# ==========================================
# 7. 預設路徑與輸出目錄 (選填，未設定時維持預設行為)
# ==========================================
# DEFAULT_OUTPUT_DIR=data/markdown_out
# DEFAULT_QUARANTINE_DIR=data/quarantine
# DEFAULT_AUDIT_REPORT=logs/audit_report.csv
# DEFAULT_SCORECARD_DIR=scorecards

# ==========================================
# 8. 系統技術日誌與可觀測性配置
# ==========================================
# 系統技術日誌輸出等級 (DEBUG, INFO, WARNING, ERROR，預設 INFO)
LOG_LEVEL=INFO

# 系統技術日誌檔案輸出路徑 (預設 logs/app.log，設為空則僅輸出至控制台)
LOG_FILE=logs/app.log

# 單一日誌檔案最大上限 (Bytes，預設 10485760 即 10MB)
LOG_MAX_BYTES=10485760

# 日誌滾動備份保留份數 (預設 5)
LOG_BACKUP_COUNT=5

# ==========================================
# 9. Web 查詢儀表板配置 (Web Dashboard)
# ==========================================
# Web 儀表板監聽 IP 位址 (預設 127.0.0.1)
WEB_HOST=127.0.0.1

# Web 儀表板監聽 Port 埠號 (預設 8080)
WEB_PORT=8080

# Web 儀表板伺服器引擎選擇 (auto, fastapi, builtin，預設 auto)
WEB_ENGINE=auto


# ==========================================
# 10. HR 多輪對話招募助手 (ADR-0019)
# ==========================================
# 招募助手總開關 (true/false，預設 true；需 FastAPI 引擎、API Key 與 Redis 向量庫)
RECRUIT_CHAT_ENABLED=true

# 招募助手 LLM 模型 (留空則沿用 GEMINI_MODEL)
RECRUIT_LLM_MODEL=

# 招募助手 LLM 溫度、最大輸出 Token 與單次呼叫逾時秒數
RECRUIT_LLM_TEMPERATURE=0.2
RECRUIT_LLM_MAX_OUTPUT_TOKENS=2048
RECRUIT_LLM_TIMEOUT_SECONDS=45

# 履歷結構化抽取專用最大輸出 Token (抽取輸出精簡，獨立收斂以縮短冷啟延遲)
RECRUIT_PROFILE_MAX_OUTPUT_TOKENS=1024
# 長文敘述輸出上限 (推薦理由 / 追問回答 / 一般問答 / 面試題)；Gemini 2.5 系列 thinking token 計入此額度，故設較大值
RECRUIT_NARRATIVE_MAX_OUTPUT_TOKENS=8192
# Gemini thinking 預算 (token)：留空=模型預設、0=關閉 thinking、正整數=上限；套件版本不支援時忽略並記錄
# 作用範圍：主模型所有 LLM 操作 (意圖分類、JD/履歷抽取、敘述)，非僅敘述；不支援 thinking 的模型設正整數可能使每次呼叫失敗
RECRUIT_LLM_THINKING_BUDGET=

# 候選池檢索：向量檢索切片數、最低相似度、候選池 Top-N 與 N 硬上限
RECRUIT_RETRIEVAL_TOP_K_CHUNKS=60
RECRUIT_RETRIEVAL_MIN_SCORE=0.5
RECRUIT_CANDIDATE_POOL_SIZE=15
RECRUIT_CANDIDATE_POOL_MAX=30

# 候選人不足時自動擴大檢索 (ADR-0021)：只擴大語意檢索範圍，絕不放寬招募條件；MAX_ROUNDS=0 停用
# 基準輪之後最多擴大輪數 [0,5]、每輪增加之候選池目標人數 [1,50]、單輪累計評估人數硬上限 [CANDIDATE_POOL_SIZE,100]
RECRUIT_SEARCH_EXPANSION_MAX_ROUNDS=2
RECRUIT_SEARCH_EXPANSION_POOL_STEP=10
RECRUIT_SEARCH_EXPANSION_POOL_MAX=40
# 檢索切片數上限 [RETRIEVAL_TOP_K_CHUNKS,1000]；候選池飽和時相似度門檻降幅 (0,0.5] 與下限 [0,RETRIEVAL_MIN_SCORE]
RECRUIT_SEARCH_EXPANSION_TOP_K_CHUNKS_MAX=200
RECRUIT_SEARCH_EXPANSION_MIN_SCORE_STEP=0.05
RECRUIT_SEARCH_EXPANSION_MIN_SCORE_FLOOR=0.4
# 保留給推薦理由等後續步驟之 LLM 呼叫次數 [0,10]；剩餘秒數低於此值不再開始新一輪 [0,TURN_TIMEOUT]
RECRUIT_SEARCH_EXPANSION_LLM_RESERVE=2
RECRUIT_SEARCH_EXPANSION_MIN_REMAINING_SECONDS=30

# 放寬條件之人工決策 (ADR-0022)：人數不足時暫停，由使用者在 UI 勾選要放寬（降為加分）的必要條件後重新比對
# 關閉時只顯示放寬報告；同一 JD 最多人工放寬輪數 [1,5]
RECRUIT_RELAXATION_HITL_ENABLED=true
RECRUIT_RELAXATION_MAX_ROUNDS=2

# 推薦名單預設人數與上限
RECRUIT_SHORTLIST_SIZE=3
RECRUIT_SHORTLIST_MAX=10

# 必要條件數上限、單輪意圖數上限、前置規則判定 JD 之長度門檻 (字元)
RECRUIT_MAX_MUST_REQUIREMENTS=12
RECRUIT_MAX_INTENTS_PER_TURN=2
RECRUIT_JD_INTENT_MIN_CHARS=200

# 延遲抽取：單份履歷送抽取字元上限與並行數
RECRUIT_PROFILE_MAX_RESUME_CHARS=12000
RECRUIT_PROFILE_MAX_CONCURRENCY=8

# 抽取失敗之短期負快取秒數 (同履歷內容與抽取版本於冷卻期內不重打 LLM，直接採用降級資料；0 表示停用)
RECRUIT_PROFILE_NEGATIVE_CACHE_TTL_SECONDS=600

# Profile / JD 快取鍵前綴與 TTL 秒數 (預設 30 天)
RECRUIT_PROFILE_CACHE_PREFIX=recruit:v1:profile:
RECRUIT_JD_CACHE_PREFIX=recruit:v1:jd:
RECRUIT_PROFILE_CACHE_TTL_SECONDS=2592000

# 證據引文最短有效字元數
RECRUIT_EVIDENCE_MIN_CHARS=4

# 面試題預設題數與上限
RECRUIT_DEFAULT_INTERVIEW_QUESTIONS=3
RECRUIT_MAX_INTERVIEW_QUESTIONS=10

# 安全上限：訊息字元數、單輪 LLM 呼叫數、單輪逾時秒數、429 熔斷冷卻秒數
RECRUIT_MAX_MESSAGE_CHARS=12000
RECRUIT_MAX_LLM_CALLS_PER_TURN=25
RECRUIT_TURN_TIMEOUT_SECONDS=150
RECRUIT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# 受保護屬性詞彙表 (逗號分隔；命中之 JD 條件忽略、履歷欄位行遮蔽、面試題剔除)
# 英文詞彙大小寫不敏感且以字界比對 (age 不會命中 manage)；Markdown 表格依表頭整欄遮蔽
RECRUIT_PROTECTED_ATTR_TERMS=年齡,歲,出生,生日,出生日期,生辰,性別,男性,女性,婚姻,已婚,未婚,婚育,懷孕,照片,大頭照,宗教,國籍,籍貫,身高,體重,血型,gender,sex,age,birth,dob,birthday,marital,married,religion,nationality,photo

# 技能別名 (別名:正規名，逗號分隔)
# 注意：設定此變數會「整組取代」預設別名表，請自行帶入所有需要的別名
RECRUIT_SKILL_ALIASES=golang:go,k8s:kubernetes,js:javascript,ts:typescript,node.js:nodejs,node:nodejs,postgres:postgresql,reactjs:react,react.js:react,vue.js:vue,vuejs:vue,ci/cd:cicd,pl/sql:plsql,tcp/ip:tcpip,a/b testing:abtesting
# 技能詞面回退 (履歷全文掃描) 之非歧義最短詞長；短於此值 (如 go、r、c) 僅判 UNKNOWN
RECRUIT_SKILL_LEXICAL_MIN_CHARS=3
# 詞面回退證據片段 (命中所在行) 字元上限
RECRUIT_SKILL_MENTION_SNIPPET_CHARS=80
# 不去除版本尾碼之技能詞 (逗號分隔)，避免 web3 被誤併為 web
RECRUIT_SKILL_VERSION_STRIP_EXEMPT=web3,b2b,b2c,e2e,p2p,base64,utf8,utf-8,sha256,arm64
# 詞面回退時不作為搜尋詞之別名 (同形異義通用詞，如 node 之於 nodejs；逗號分隔)
# 注意：留空會退回預設值 node，無法以空值停用此機制
RECRUIT_SKILL_LEXICAL_ALIAS_DENYLIST=node

# 對話狀態 Checkpointer 後端 (memory / redis；redis 需安裝 langgraph-checkpoint-redis 與 Redis Stack)
CHAT_CHECKPOINTER_BACKEND=memory

# Redis Checkpointer 連線 (留空則沿用 REDIS_URL)
# 注意：RedisSaver 依賴 RediSearch 索引，而 RediSearch 僅支援 db0；請使用 db0 並以鍵前綴 (chat:v1:*) 隔離，勿指向 /1 以上之 db
CHAT_CHECKPOINT_REDIS_URL=

# Session 閒置 TTL 秒數、送 LLM 之歷史輪數/字元上限、Session 總輪數上限、記憶體 Session 上限
CHAT_SESSION_TTL_SECONDS=3600
CHAT_HISTORY_MAX_TURNS=10
CHAT_HISTORY_MAX_CHARS=24000
CHAT_SESSION_MAX_TURNS=50
CHAT_MEMORY_MAX_SESSIONS=200

# Session 鎖 TTL 緩衝秒數 (鎖 TTL = RECRUIT_TURN_TIMEOUT_SECONDS + 本值，避免長回合鎖提前過期)
CHAT_SESSION_LOCK_TTL_BUFFER_SECONDS=30

# ==========================================
# 招募助手 LangSmith 遮蔽式效能追蹤 (ADR-0020，預設關閉)
# ==========================================
# 僅上傳延遲、token 用量、節點結構與例外類別名；prompt / 回覆 / 對話狀態一律不上傳
# 警告：勿設定全域 LANGSMITH_TRACING / LANGCHAIN_TRACING_V2，全域追蹤會繞過遮蔽政策上傳完整內容
RECRUIT_TRACING_ENABLED=false
# LangSmith 金鑰 (機密：僅置於 .env，嚴禁納入版控)
LANGSMITH_API_KEY=
# 端點 (留空使用 SDK 預設；EU 區或自架版請填入對應 URL)
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=recruitment-assistant
# 僅供 tests/eval/run_ragas_faithfulness.py --fetch-verdicts 讀回評測 trace（練習用，正式程式不讀取）
# 需具 projects:read 權限（如 Personal Access Token）；與上方只寫入的 LANGSMITH_API_KEY 分開以維持最小權限
LANGSMITH_READ_API_KEY=
# 取樣率 0.0 ~ 1.0 (超出範圍自動夾限；非數值退回 1.0)
RECRUIT_TRACING_SAMPLING_RATE=1.0
# 服務關閉時等待追蹤上傳之秒數上限 (端點不可達時避免拖延關機；逾時捨棄未送出資料；0 表示不等待)
RECRUIT_TRACING_FLUSH_TIMEOUT_SECONDS=5
